    oAsmDoc = ThisApplication.ActiveDocument

    ' Limpar a seleção atual
    oAsmDoc.SelectSet.Clear()

    ' Restaurar todos os elementos da seleção original
    For Each item In storedSelections

        oAsmDoc.SelectSet.Select(item)

    Next

