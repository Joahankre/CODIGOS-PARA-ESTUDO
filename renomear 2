Sub FormatLeadingZeros(oSelections As SelectSet)

    Dim oAsmDoc As Inventor.AssemblyDocument
    oAsmDoc = ThisApplication.ActiveDocument

    ' Gerar uma lista com os nomes de exibição dos componentes
    Dim displayNamesList As String = ""

    For Each oComp In oSelections

        displayNamesList &= oComp.Name & vbCrLf

    Next

    displayNamesList = TruncateTextBlock(
        displayNamesList,
        30,
        41,
        "",
        "...",
        "... A lista continua aqui"
    )

    ' Solicitar ao usuário o modelo de formatação
    Dim template As String = InputBox(
        "Componentes selecionados" & vbCrLf &
        displayNamesList & vbCrLf & vbCrLf & vbCrLf &
        "Digite o modelo de formatação:",
        "CADMajigs"
    )

    ' Verificar se o usuário solicitou ajuda
    If UCase(template) = "HELP" Then

        LeadingZerosHelp("Você solicitou ajuda.", "")
        Exit Sub

    ElseIf template = "" Then

        LeadingZerosHelp(
            "Operação cancelada ou nenhum modelo informado. Nenhuma alteração foi realizada.",
            ""
        )

        Exit Sub

    End If

    ' Verificar se o modelo contém somente números
    ' Caso positivo, adicionar automaticamente o identificador A:
    If IsNumeric(template) Then

        template = "A:" & template

    End If

    On Error GoTo ErrorHandler

    ' Separar as instruções individuais do modelo
    Dim instructions() As String = Split(template, ",")

    ' Percorrer todos os nomes de exibição e aplicar a formatação
    For Each oComp In oSelections

        Dim formattedName As String =
            oComp.Name.Substring(0, oComp.Name.LastIndexOf(":"))

        For Each instruction As String In instructions

            Dim parts() As String = Split(instruction, ":")

            Dim indexOrAllOrTruncate As String = parts(0)
            Dim lengthInfo As String = parts(1)

            ' Verificar se a instrução utiliza A para formatar todos os números
            If indexOrAllOrTruncate.ToUpper() = "A" Then

                formattedName = ReplaceAllNumbers(formattedName, lengthInfo)

            Else

                Dim index As Integer = CInt(indexOrAllOrTruncate)

                ' Obter o número desejado pela sua posição
                ' Também é possível contar a partir do último número
                Dim numberToFormat As String =
                    GetNthNumber(formattedName, index)

                If numberToFormat = "" Then Continue For

                ' Aplicar a formatação ao número
                Dim formattedNumber As String =
                    FormatNumber(numberToFormat, lengthInfo)

                ' Substituir o número original pelo número formatado
                formattedName = ReplaceNthNumber(
                    formattedName,
                    index,
                    formattedNumber
                )

            End If

        Next

        ' Atualizar o nome de exibição caso tenha ocorrido alguma alteração
        If oComp.Name <> formattedName Then

            oComp.Name = GetUniqueDisplayName(formattedName)

        End If

    Next

    Exit Sub

ErrorHandler:

    ' Exibir as instruções caso ocorra algum erro no modelo informado
    LeadingZerosHelp("O modelo informado não é válido!", "")

End Sub


Function TruncateTextBlock(
    ByVal textBlock As String,
    ByVal maxLines As Integer,
    ByVal maxCharsPerLine As Integer,
    prefixContent As String,
    inlineSuffix As String,
    suffixContent As String
) As String

    Dim truncatedTextBlock As String
    Dim lineCount As Integer

    ' Separar a lista em linhas individuais
    Dim lines() As String = Split(textBlock, vbCrLf)

    Dim i As Integer

    ' Verificar cada linha e considerar a quebra automática de texto
    For i = 0 To UBound(lines)

        Dim wrappedLines As Integer

        ' Calcular quantas linhas serão necessárias para exibir o texto
        wrappedLines = Ceiling(Len(lines(i)) / maxCharsPerLine)

        ' Verificar se a inclusão dessas linhas ultrapassará o limite máximo
        If lineCount + wrappedLines > maxLines Then

            Exit For

        End If

        ' Adicionar a linha à lista e atualizar o contador
        truncatedTextBlock &= lines(i) & vbCrLf

        lineCount = lineCount + wrappedLines

    Next i

    ' Se ainda existirem linhas, adicionar reticências para indicar que a lista foi cortada
    If i < UBound(lines) Then

        ' Remover a última quebra de linha
        truncatedTextBlock = Left(
            truncatedTextBlock,
            Len(truncatedTextBlock) - Len(vbCrLf)
        )

        truncatedTextBlock &= inlineSuffix

        If prefixContent <> "" Then

            truncatedTextBlock =
                prefixContent & vbCrLf & vbCrLf & truncatedTextBlock

        End If

        If suffixContent <> "" Then

            truncatedTextBlock &=
                vbCrLf & vbCrLf & suffixContent

        End If

    End If

    ' Retornar a lista formatada
    Return truncatedTextBlock

End Function


Function Ceiling(ByVal num As Double) As Integer

    ' Função auxiliar para arredondar um número para o próximo inteiro
    Ceiling = -Int(-num)

End Function


Function FormatNumber(numberToFormat As String, length As String) As String

    ' Se começar com P, preservar os zeros existentes à esquerda
    If length.StartsWith("P") Then

        Return numberToFormat.PadLeft(
            CInt(length.Substring(1)),
            "0"c
        )

    End If

    ' Converter o número e adicionar zeros à esquerda até atingir o tamanho desejado
    Return CInt(numberToFormat).ToString().PadLeft(
        CInt(length),
        "0"c
    )

End Function


Function ReplaceAllNumbers(inputStr As String, lengthInfo As String) As String

    Dim result As String = ""
    Dim currentNumber As String = ""

    ' Percorrer todos os caracteres do texto
    For Each character As Char In inputStr

        If Char.IsDigit(character) Then

            currentNumber &= character

        Else

            If currentNumber <> "" Then

                ' Formatar o número encontrado
                result &= FormatNumber(currentNumber, lengthInfo)

                currentNumber = ""

            End If

            result &= character

        End If

    Next

    ' Processar o último número, caso exista
    If currentNumber <> "" Then

        result &= FormatNumber(currentNumber, lengthInfo)

    End If

    Return result

End Function


Function GetNthNumber(inputStr As String, n As Integer) As String

    Dim Regex As New System.Text.RegularExpressions.Regex("\d+")

    Dim matches As System.Text.RegularExpressions.MatchCollection =
        Regex.Matches(inputStr)

    Dim numberCount As Integer = matches.Count

    ' Retornar uma string vazia se não houver números
    ' ou se a posição informada for inválida
    If numberCount = 0 Then Return ""

    If n = 0 Then Return ""

    ' Se o número for positivo, buscar a posição contando do início
    If n > 0 Then

        If n <= numberCount Then

            Return matches(n - 1).Value

        End If

        Return ""

    End If

    ' Se o número for negativo, contar a posição a partir do final
    If Abs(n) <= numberCount Then

        Return matches(numberCount + n).Value

    End If

    Return ""

End Function


Function ReplaceNthNumber(
    inputStr As String,
    n As Integer,
    replacement As String
) As String

    If n = 0 Then Return inputStr

    Dim Regex As New System.Text.RegularExpressions.Regex("\d+")

    Dim matches As System.Text.RegularExpressions.MatchCollection =
        Regex.Matches(inputStr)

    Dim numberCount As Integer = matches.Count

    ' Se não houver números ou a posição for inválida, retornar o texto original
    If numberCount = 0 Then Return inputStr

    If n > Math.Abs(numberCount) Then Return inputStr

    ' Determinar a posição real do número
    Dim actualIndex As Integer =
        IIf(n > 0, n - 1, numberCount + n)

    ' Separar o texto antes e depois do número que será substituído
    Dim prefix As String =
        inputStr.Substring(0, matches(actualIndex).Index)

    Dim suffix As String =
        inputStr.Substring(
            matches(actualIndex).Index + matches(actualIndex).Length
        )

    ' Reconstruir o texto com o número formatado
    Return prefix & replacement & suffix

End Function


