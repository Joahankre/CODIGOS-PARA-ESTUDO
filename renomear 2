Function GetParameterValue(oComp As ComponentOccurrence, parameterName As String) As String

    Try

        Dim param As Parameter = Nothing

        ' Tentar obter o parâmetro em ModelParameters
        Try

            param = oComp.Definition.Parameters.ModelParameters.Item(parameterName)

        Catch ex As Exception

            ' Caso não seja encontrado em ModelParameters,
            ' tentar localizar em UserParameters
            param = oComp.Definition.Parameters.UserParameters.Item(parameterName)

        End Try

        ' Retornar o valor do parâmetro, caso ele exista
        If param IsNot Nothing Then

            Return param.Value.ToString()

        Else

            Throw New Exception("Parâmetro não encontrado.")

        End If

    Catch ex As Exception

        ' Retornar uma string vazia caso o parâmetro não seja encontrado
        Return ""

    End Try

End Function


